# Discord bot token (REQUIRED). Get from https://discord.com/developers/applications
# Never share this file, never commit it to GitHub.
DISCORD_TOKEN=PASTE-YOUR-BOT-TOKEN-HERE

# Role that is allowed to run /key and /setkey
ALLOWED_ROLE_ID=1549095037445341314

# Guild ID where the bot runs (optional but recommended so commands sync fast)
GUILD_ID=

# Optional: GitHub token so /setkey can auto-push keys.json to your repo (raw link stays live).
# Needs repo Contents:write permission. Leave empty to only save locally.
GITHUB_TOKEN=
GITHUB_REPO=Frost-GG-Hud/Loader
GITHUB_BRANCH=main

# Optional: your own website host (Render / Railway / Glitch) serving the script.
# /script then prints:  loadstring(game:HttpGet("<SITE_URL>/api/script"))()
# and /setkey pushes the new key to the site. Leave empty to keep using GitHub raw links.
SITE_URL=https://frost.onrender.com
SITE_ADMIN_TOKEN=PASTE-A-LONG-RANDOM-TOKEN